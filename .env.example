# ==============================================================================
# SentinelEye Environment Configuration Template (.env.example)
# Copy this file to .env and adjust variables as necessary for your local station.
# In production/demo, no network calls are initiated.
# ==============================================================================

# --- Operating Mode ---
APP_ENV=demo
DEBUG=false
DEVICE=cuda                               # cuda or cpu
LOG_LEVEL=INFO

# --- Strict Offline & Air-Gap Flags ---
OFFLINE_MODE=true
HF_HUB_OFFLINE=1                          # Blocks Hugging Face online hub checks
TRANSFORMERS_OFFLINE=1                    # Forces transformers to use local cache

# --- Stage Demo Contingency Toggle ---
REPLAY_MODE=false                         # Set true to use cached precomputed outputs (0ms inference)
REPLAY_DATA_DIR=./data/precomputed

# --- Model Checkpoint Paths (Must exist locally in ./models) ---
MODEL_WEIGHTS_DIR=./models
REMOTECLIP_WEIGHTS_PATH=./models/remoteclip/remoteclip_vit_b32.pt
BIT_WEIGHTS_PATH=./models/bit/bit_base_bitemporal.pth
BAN_ADAPTER_PATH=./models/ban/ban_adapter.pth
PRITHVI_WEIGHTS_PATH=./models/prithvi/prithvi_eo_2_300m.pt
YOLO_SAHI_WEIGHTS_PATH=./models/yolo/yolov8n_sahi.pt

# --- Local LLM Engine Configuration ---
LLM_BACKEND=llama_cpp                     # llama_cpp or ollama
LLM_MODEL_PATH=./models/llm/qwen2.5-7b-instruct-q4_k_m.gguf
LLM_N_CTX=4096
LLM_N_GPU_LAYERS=33                       # Number of layers to offload to GPU (0 for pure CPU)
LLM_TEMPERATURE=0.1                       # Near-zero temperature for deterministic factual briefs

# --- Vector Index & Metadata Stores ---
VECTOR_BACKEND=faiss                      # faiss or qdrant_embedded
FAISS_INDEX_PATH=./retrieval/indexes/sentinel_faiss.index
FAISS_METADATA_DB_PATH=./retrieval/indexes/tile_metadata.sqlite3
QDRANT_STORAGE_PATH=./retrieval/indexes/qdrant_storage

# --- Satellite Imagery & Storage ---
DATA_ROOT_DIR=./data
TILES_CACHE_DIR=./data/preprocessed/tiles_512
MAX_TILE_CACHE_SIZE_GB=20

# --- Tamper-Evident Cryptographic Audit Ledger ---
AUDIT_LOG_PATH=./audit/logs/analyst_audit_chain.log
AUDIT_SIGNING_KEY_PATH=./audit/keys/analyst_ed25519.key
AUDIT_VERIFY_KEY_PATH=./audit/keys/analyst_ed25519.pub

# --- API & Dashboard Network Bindings (Localhost / Air-gapped LAN) ---
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
STREAMLIT_SERVER_PORT=8501
